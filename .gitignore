# Système
.DS_Store
Thumbs.db
desktop.ini

# Éditeurs
.vscode/
.idea/
*.swp
*~

# Outils locaux
.claude/
node_modules/
dist/
*.log

# Environnements
.env
.env.local

# Ignorer les données
data/raw/*
data/interim/*
data/processed/*

# Ne pas ignorer les .gitkeep pour garder la structure
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Ignorer les dossiers python
__pycache__/
*.pyc

# Observabilité M7 : secrets de notification et journal d'audit local.
# Les URL de webhook et mots de passe SMTP sont montés depuis ces fichiers,
# jamais versionnés (voir monitoring/README.md).
monitoring/alertmanager/secrets/
monitoring/audit/*.jsonl
!monitoring/audit/.gitkeep

# Environnements virtuels Python locaux
.venv/
venv/
.python-version

# Local MLflow database
mlflow.db